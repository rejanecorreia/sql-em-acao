// Acrescente estas regras ao arquivo de regras ATUAL do Firebase.
// NÃO publique este arquivo sozinho sobre as regras da primeira aula:
// isso removeria permissões de suas coleções anteriores.
// Cole os dois blocos match dentro de match /databases/{database}/documents { ... }.
match /sqlEmAcao/{sala} {
  allow read: if request.auth != null;
  allow create, delete: if request.auth != null && request.auth.uid == 'b38lX9n8wkgYeQZJQavl2ENei6V2';
  allow update: if request.auth != null && (
    request.auth.uid == 'b38lX9n8wkgYeQZJQavl2ENei6V2' ||
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextSeat']) &&
     request.resource.data.nextSeat == resource.data.nextSeat + 1 &&
     resource.data.nextSeat >= 1 && resource.data.nextSeat <= 33)
  );
}
match /sqlEmAcaoMembros/{sala}/membros/{uid} {
  allow read: if request.auth != null;
  allow create: if request.auth != null && request.auth.uid == uid &&
    request.resource.data.uid == uid &&
    request.resource.data.order is int &&
    request.resource.data.order >= 1 && request.resource.data.order <= 33 &&
    request.resource.data.keys().hasOnly(['uid','order','nickname','fullName','emoji','joinedAt']) &&
    getAfter(/databases/$(database)/documents/sqlEmAcao/$(sala)).data.nextSeat == request.resource.data.order + 1;
  allow update: if false;
  allow delete: if request.auth != null && request.auth.uid == 'b38lX9n8wkgYeQZJQavl2ENei6V2';
}
